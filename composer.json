{
    "name": "restruct/silverstripe-signed-asset-urls",
    "description": "Time-expiring signed URLs for SilverStripe assets",
    "type": "silverstripe-vendormodule",
    "license": "MIT",
    "keywords": [
        "silverstripe",
        "assets",
        "signed-urls",
        "protected",
        "x-accel-redirect",
        "x-sendfile"
    ],
    "require": {
        "silverstripe/framework": "^5.0",
        "silverstripe/assets": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Restruct\\SilverStripe\\SignedAssetUrls\\": "src/"
        }
    },
    "extra": {
        "expose": [],
        "silverstripe": {
            "module-name": "signed-asset-urls"
        }
    }
}
