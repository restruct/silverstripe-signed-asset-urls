{
    "name": "restruct/silverstripe-signed-asset-urls",
    "description": "Time-limited signed URLs for protected Silverstripe files, shareable or bound to the visitor's session, served by PHP, X-Accel-Redirect or X-Sendfile",
    "type": "silverstripe-vendormodule",
    "license": "MIT",
    "authors": [
        {
            "name": "Restruct",
            "email": "dev@restruct.nl",
            "homepage": "https://restruct.nl"
        }
    ],
    "keywords": [
        "silverstripe",
        "silverstripe-module",
        "assets",
        "file-protection",
        "signed-urls",
        "presigned-urls",
        "x-accel-redirect",
        "x-sendfile"
    ],
    "require": {
        "php": "^8.1",
        "silverstripe/framework": "^5 || ^6",
        "silverstripe/assets": "^2 || ^3"
    },
    "autoload": {
        "psr-4": {
            "Restruct\\SilverStripe\\SignedAssetUrls\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Restruct\\SilverStripe\\SignedAssetUrls\\Tests\\": "tests/"
        }
    },
    "suggest": {
        "silverstripe/versioned": "^2 || ^3 - draft/live staging for File; signed URLs then refuse unpublished files. Without it every file counts as published"
    },
    "require-dev": {
        "silverstripe/recipe-testing": "^3 || ^4"
    },
    "extra": {
        "expose": [],
        "silverstripe": {
            "module-name": "signed-asset-urls"
        }
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/restruct"
        }
    ]
}
