<?xml version="1.0" encoding="UTF-8"?>
<!-- For running the suite from a HOST project that requires this module through a path repository
     (symlink: true). See README "Running the tests". failOnWarning is pinned because whether a
     warning fails a test otherwise differs between PHPUnit 9 (SS5) and 11 (SS6).
     failOnEmptyTestSuite: a run that finds no tests (wrong path, a dist install without /tests)
     must fail, not pass. -->
<phpunit bootstrap="vendor/silverstripe/framework/tests/bootstrap.php" colors="true"
         failOnWarning="true" failOnEmptyTestSuite="true">
    <testsuites>
        <testsuite name="signed-asset-urls">
            <directory>vendor/restruct/silverstripe-signed-asset-urls/tests</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="SS_ENVIRONMENT_TYPE" value="test"/>
    </php>
</phpunit>
